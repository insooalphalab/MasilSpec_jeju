# 복사해서 .env 로 저장 후 값 입력 (.env 는 절대 공유·커밋하지 않는다)

# --- 데이터 수집 ---
JEJUHUB_API_KEY=           # 제주데이터허브
DATA_GO_KR_KEY=            # 공공데이터포털 (TAGO 버스, 사고다발, 향토음식점 등)
VisitJeju_API_KEY=         # 비짓제주
KMA_APIHUB_KEY=            # 기상청 API허브 (바람)

# --- 지도·주소 (브이월드 키는 서버에서만 사용, 브라우저 HTML 에 넣지 않음) ---
Vworld_API_KEY=            # 주소→좌표, 좌표→주소, 배경지도 타일(WMTS)
Vworld2Ddata_API_KEY=      # 2D 데이터 API (수치지도 도로중심선: 도로폭)
JUSO_API_KEY=              # 행안부 도로명주소 검색 API (주소 검색 보조)

# --- 삼춘 브리핑 LLM (OpenAI 호환). 비워 두면 기본값: Ollama 로컬 + Gemma 4 12B ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:12b-it-qat
LLM_API_KEY=               # 로컬이면 비워 둠
# LLM_REASONING=none       # Gemma 4 '생각 모드' 끄기 (로컬 기본값 none)
